{
  "name": "incantly-solutus",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:playground": "npm --workspace=@incantly/playground run dev",
    "build:playground": "npm --workspace=@incantly/playground run build",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
