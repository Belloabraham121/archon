{
  "name": "incantly-solutus",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:playground": "npm --workspace=@incantly/playground run dev",
    "build:playground": "npm --workspace=@incantly/playground run build",
    "test": "esbuild tests/phase3-core.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/incantly-solutus-phase3-test.mjs && node --test /tmp/incantly-solutus-phase3-test.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
