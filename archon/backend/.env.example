# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=v1

# PostgreSQL (system of record — Prisma + Better Auth tables live here)
DATABASE_URL=postgresql://archon:archon@localhost:5432/archon?schema=public

# Redis (rate limits, idempotency, ephemeral quote state)
REDIS_URL=redis://localhost:6379

# NATS JetStream (durable event distribution)
NATS_URL=nats://localhost:4222

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-secret
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Jev (TypeSafe System One judgments — Tier 3 escalation only)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2500
JEV_MAX_CALLS_PER_MINUTE=600
