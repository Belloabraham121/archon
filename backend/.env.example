# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=v1

# PostgreSQL (system of record — Prisma + Better Auth tables live here)
DATABASE_URL=postgresql://archon:archon@localhost:5433/archon?schema=public

# Redis (rate limits, idempotency, ephemeral quote state)
REDIS_URL=redis://localhost:6379

# NATS JetStream (durable event distribution)
NATS_URL=nats://localhost:4222

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-secret
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Jev (TypeSafe System One judgments — Tier 3 escalation only)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2500
JEV_MAX_CALLS_PER_MINUTE=600
JEV_CONFIDENCE_FLOOR=0.5
JEV_SHADOW=false
JEV_MAX_TOKENS_PER_MINUTE=500000
JEV_CONCURRENCY=4
JEV_INPUT_COST_PER_MILLION=0
JEV_OUTPUT_COST_PER_MILLION=0

# Phase 3 live adapter boundary. Leave empty to use clearly labelled local venue models.
BASE_RPC_URL=
ZEROX_API_KEY=
ODOS_API_KEY=
QUOTE_TTL_MS=30000
